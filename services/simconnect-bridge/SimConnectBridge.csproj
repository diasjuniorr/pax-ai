<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PaxAgent</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <SimConnectSdkDir Condition="'$(SimConnectSdkDir)' == ''">$(MSFS2024_SDK)\SimConnect SDK</SimConnectSdkDir>
    <SimConnectManagedDll Condition="'$(SimConnectManagedDll)' == ''">$(SimConnectSdkDir)\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
    <SimConnectNativeDll Condition="'$(SimConnectNativeDll)' == ''">$(SimConnectSdkDir)\lib\SimConnect.dll</SimConnectNativeDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectManagedDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(SimConnectNativeDll)" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(SimConnectNativeDll)')" />
  </ItemGroup>
  <Target Name="CheckSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SimConnectManagedDll)')" Text="Managed SimConnect SDK DLL not found. Set MSFS2024_SDK or SimConnectManagedDll. See README.md." />
    <Error Condition="!Exists('$(SimConnectNativeDll)')" Text="Native SimConnect DLL not found. Set SimConnectNativeDll to the matching x64 SDK library." />
  </Target>
</Project>
