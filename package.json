{
  "name": "pax", "private": true, "version": "0.1.0", "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=20.11"},
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-bridge.ps1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {"ws": "^8.18.0", "zod": "^3.24.0"},
  "devDependencies": {"@types/node": "^20.17.0", "@types/ws": "^8.5.13", "concurrently": "^9.1.0", "tsx": "^4.19.0", "typescript": "^5.7.0", "vite": "^6.1.0"}
}
