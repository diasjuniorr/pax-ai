{
  "name": "pax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-bridge.ps1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && esbuild apps/server/src/index.ts --bundle --platform=node --format=cjs --external:ws --outfile=dist/server/index.cjs",
    "start": "node dist/server/index.cjs",
    "test:hosted-build": "node scripts/check-hosted-build.mjs",
    "test:browser": "playwright test",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
